APP_NAME=VABOS Staff API
ENVIRONMENT=dev

# Supabase Postgres pooler. Put real values in backend .env/deployment secrets.
# Never expose these values to Flutter/mobile clients.
user=postgres.bkbgrgbuxhsykvtgsoez
password=[YOUR-PASSWORD]
host=aws-1-ap-northeast-1.pooler.supabase.com
port=6543
dbname=postgres
SUPABASE_DB_USER=postgres.bkbgrgbuxhsykvtgsoez
SUPABASE_DB_PASSWORD=[YOUR-PASSWORD]
SUPABASE_DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
DATABASE_URL=postgresql+asyncpg://postgres.bkbgrgbuxhsykvtgsoez:[URL-ENCODED-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?ssl=require&prepared_statement_cache_size=0
DATABASE_USE_NULL_POOL=true

# Redis Cloud. Put the real password in backend .env/deployment secrets.
REDIS_HOST=turbolight-resilient-pan-33081.db.redis.io
REDIS_PORT=18108
REDIS_USERNAME=default
REDIS_PASSWORD=[YOUR-REDIS-PASSWORD]
REDIS_DB=0

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=*
CREATE_TABLES_ON_STARTUP=true

# Optional backend-only test account. Do not expose in Flutter UI.
TEST_STAFF_EMAIL=test@vriddhi.app
TEST_STAFF_PASSWORD=Test@12345
TEST_STAFF_NAME=Test Staff
TEST_BUSINESS_ID=test_business
TEST_BRANCH_ID=test_branch

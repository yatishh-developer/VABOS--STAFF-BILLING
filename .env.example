APP_NAME=VABOS Staff API
ENVIRONMENT=dev
# Local development:
DATABASE_URL=postgresql+asyncpg://vabos:vabos@localhost:5432/vabos_staff

# Supabase pooler config. Prefer DATABASE_URL in deployed secrets, or set these
# parts in backend .env. Do not expose any of these to Flutter/mobile clients.
SUPABASE_DB_USER=postgres.bkbgrgbuxhsykvtgsoez
SUPABASE_DB_PASSWORD=[YOUR-PASSWORD]
SUPABASE_DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres

# Also supported for local-only .env files if copied from Supabase examples:
# user=postgres.bkbgrgbuxhsykvtgsoez
# password=[YOUR-PASSWORD]
# host=aws-1-ap-northeast-1.pooler.supabase.com
# port=6543
# dbname=postgres

# Production Supabase Postgres. Keep the real password only in backend secrets.
# Never expose this URL to Flutter/mobile clients.
# DATABASE_URL=postgresql+asyncpg://postgres.bkbgrgbuxhsykvtgsoez:<PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?ssl=require
DATABASE_USE_NULL_POOL=true
REDIS_URL=redis://localhost:6379/1
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CREATE_TABLES_ON_STARTUP=false
